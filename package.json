{
  "name": "static-toolkit",
  "version": "0.1.0",
  "description": "可部署到 GitHub Pages 的静态工具站，每个工具一个独立页面",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "holidays:add": "node scripts/holidays-add.mjs",
    "lint": "eslint .",
    "new": "node scripts/new-tool.mjs",
    "og:image": "node scripts/generate-og-image.mjs",
    "preview": "vite preview",
    "quotes:add": "node scripts/quotes-add.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.8.1",
    "glob": "^11.0.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  }
}
