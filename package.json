{
  "name": "static-toolkit",
  "version": "0.1.0",
  "description": "可部署到 GitHub Pages 的静态工具站，每个工具一个独立页面",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "holidays:add": "node scripts/holidays-add.mjs",
    "lint": "eslint .",
    "new": "node scripts/new-tool.mjs",
    "og:image": "node scripts/generate-og-image.mjs",
    "preview": "vite preview",
    "quotes:add": "node scripts/quotes-add.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.8.1",
    "glob": "^11.0.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "dompurify": "^3.4.16",
    "html-to-image": "^1.11.13",
    "jsqr": "^1.4.0",
    "katex": "^0.18.10",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.0.0",
    "qrcode": "^1.5.4",
    "shiki": "^4.4.3"
  }
}
