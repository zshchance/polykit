{
  "name": "static-toolkit",
  "version": "0.1.0",
  "description": "可部署到 GitHub Pages 的静态工具站，每个工具一个独立页面",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "new": "node scripts/new-tool.mjs",
    "holidays:add": "node scripts/holidays-add.mjs",
    "quotes:add": "node scripts/quotes-add.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "glob": "^11.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  }
}
